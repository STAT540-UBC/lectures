@ARTICLE{Brunet2004-fk,
  title     = "Metagenes and molecular pattern discovery using matrix
               factorization",
  author    = "Brunet, Jean-Philippe and Tamayo, Pablo and Golub, Todd R and
               Mesirov, Jill P",
  journal   = "Proc. Natl. Acad. Sci. U. S. A.",
  publisher = "Proceedings of the National Academy of Sciences",
  volume    =  101,
  number    =  12,
  pages     = "4164--4169",
  abstract  = "We describe here the use of nonnegative matrix factorization
               (NMF), an algorithm based on decomposition by parts that can
               reduce the dimension of expression data from thousands of genes
               to a handful of metagenes. Coupled with a model selection
               mechanism, adapted to work for any stochastic clustering
               algorithm, NMF is an efficient method for identification of
               distinct molecular patterns and provides a powerful method for
               class discovery. We demonstrate the ability of NMF to recover
               meaningful biological information from cancer-related microarray
               data. NMF appears to have advantages over other methods such as
               hierarchical clustering or self-organizing maps. We found it less
               sensitive to a priori selection of genes or initial conditions
               and able to detect alternative or context-dependent patterns of
               gene expression in complex biological systems. This ability,
               similar to semantic polysemy in text, provides a general method
               for robust molecular pattern discovery.",
  month     =  mar,
  year      =  2004,
  language  = "en"
}
@ARTICLE{Kotliar2019-zw,
  title     = "Identifying gene expression programs of cell-type identity and
               cellular activity with single-cell {RNA}-Seq",
  author    = "Kotliar, Dylan and Veres, Adrian and Nagy, M Aurel and Tabrizi,
               Shervin and Hodis, Eran and Melton, Douglas A and Sabeti, Pardis
               C",
  journal   = "Elife",
  publisher = "eLife Sciences Publications, Ltd",
  volume    =  8,
  number    = "e43803",
  abstract  = "Identifying gene expression programs underlying both cell-type
               identity and cellular activities (e.g. life-cycle processes,
               responses to environmental cues) is crucial for understanding the
               organization of cells and tissues. Although single-cell RNA-Seq
               (scRNA-Seq) can quantify transcripts in individual cells, each
               cell's expression profile may be a mixture of both types of
               programs, making them difficult to disentangle. Here, we
               benchmark and enhance the use of matrix factorization to solve
               this problem. We show with simulations that a method we call
               consensus non-negative matrix factorization (cNMF) accurately
               infers identity and activity programs, including their relative
               contributions in each cell. To illustrate the insights this
               approach enables, we apply it to published brain organoid and
               visual cortex scRNA-Seq datasets; cNMF refines cell types and
               identifies both expected (e.g. cell cycle and hypoxia) and novel
               activity programs, including programs that may underlie a
               neurosecretory phenotype and synaptogenesis.",
  month     =  jul,
  year      =  2019,
  keywords  = "brain organoids; computational biology; gene expression programs;
               genetics; genomics; human; matrix factorization; mouse;
               single-cell Rna-Seq; synaptogenesis; systems biology; visual
               cortex",
  language  = "en"
}
@ARTICLE{Kharchenko2021-wr,
  title    = "The triumphs and limitations of computational methods for
              {scRNA}-seq",
  author   = "Kharchenko, Peter V",
  journal  = "Nat. Methods",
  volume   =  18,
  number   =  7,
  pages    = "723--732",
  abstract = "Single-cell RNA sequencing has become a widespread approach for
              studying cellular heterogeneity. While the measurements provide
              detailed information about transcriptional differences among
              individual cells, inference of biological variation from such
              data requires extensive computational analysis. Although
              hundreds of computational methods have been developed to process
              and interpret scRNA-seq data, it can be difficult to predict how
              well a specific method will perform in a given situation,
              especially for users without extensive computational expertise.
              In this Perspective, I discuss current practices of scRNA-seq
              data analysis and outline remaining challenges. I argue that
              while computational methods have been essential to the success
              of scRNA-seq studies, their proper application requires attention
              to numerous details that are often not fully appreciated.",
  month    =  jul,
  year     =  2021,
  language = "en"
}
