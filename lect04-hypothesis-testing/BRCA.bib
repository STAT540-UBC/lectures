@ARTICLE{Araki2015-bc,
  title    = "Inhibitors of {CLK} protein kinases suppress cell growth and
              induce apoptosis by modulating pre-{mRNA} splicing",
  author   = "Araki, Shinsuke and Dairiki, Ryo and Nakayama, Yusuke and Murai,
