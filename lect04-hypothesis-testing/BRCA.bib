  year     =  2012,
  language = "en"
}


@ARTICLE{Brandes2022-nk,
  title     = "Open problems in human trait genetics",
  author    = "Brandes, Nadav and Weissbrod, Omer and Linial, Michal",
  journal   = "Genome Biol.",
  publisher = "BioMed Central",
  volume    =  23,
  number    =  1,
  pages     = "1--32",
  abstract  = "Genetic studies of human traits have revolutionized our
               understanding of the variation between individuals, and yet, the
               genetics of most traits is still poorly understood. In this
               review, we highlight the major open problems that need to be
               solved, and by discussing these challenges provide a primer to
               the field. We cover general issues such as population structure,
               epistasis and gene-environment interactions, data-related issues
               such as ancestry diversity and rare genetic variants, and
               specific challenges related to heritability estimates, genetic
               association studies, and polygenic risk scores. We emphasize the
               interconnectedness of these problems and suggest promising
               avenues to address them.",
  month     =  jun,
  year      =  2022,
  language  = "en"
}


@ARTICLE{Phung2023-wt,
  title    = "A framework for assessing interactions for risk stratification
              models: the example of ovarian cancer",
  author   = "Phung, Minh Tung and Lee, Alice W and McLean, Karen and
