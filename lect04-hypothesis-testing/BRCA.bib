@ARTICLE{Osako2020-mq,
  title     = "Age-correlated protein and transcript expression in breast cancer
               and normal breast tissues is dominated by host endocrine effects",
  author    = "Osako, Tomo and Lee, Hakwoo and Turashvili, Gulisa and Chiu,
               Derek and McKinney, Steven and Joosten, Stacey E P and Wilkinson,
