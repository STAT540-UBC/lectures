@ARTICLE{Rashkin2020-uj,
  title    = "Pan-cancer study detects genetic risk variants and shared genetic
              basis in two large cohorts",
  author   = "Rashkin, Sara R and Graff, Rebecca E and Kachuri, Linda and Thai,
              Khanh K and Alexeeff, Stacey E and Blatchins, Maruta A and
              Cavazos, Taylor B and Corley, Douglas A and Emami, Nima C and
