              Alain and Lacombe, Louis and Lupien, Mathieu and Fradet, Yves and
              Têtu, Bernard and McPherson, John D and Pasaniuc, Bogdan and
              Kislinger, Thomas and Chua, Melvin L K and Pomerantz, Mark M and
              van der Kwast, Theodorus and Freedman, Matthew L and Mani, Ram S
              and He, Housheng H and Bristow, Robert G and Boutros, Paul C",
  journal  = "Nat. Med.",
  abstract = "Oncogenesis is driven by germline, environmental and stochastic
              factors. It is unknown how these interact to produce the molecular
              phenotypes of tumors. We therefore quantified the influence of
              germline polymorphisms on the somatic epigenome of 589 localized
              prostate tumors. Predisposition risk loci influence a tumor's
              epigenome, uncovering a mechanism for cancer susceptibility. We
              identified and validated 1,178 loci associated with altered
              methylation in tumoral but not nonmalignant tissue. These tumor
              methylation quantitative trait loci influence chromatin structure,
              as well as RNA and protein abundance. One prominent tumor
              methylation quantitative trait locus is associated with AKT1
              expression and is predictive of relapse after definitive local
              therapy in both discovery and validation cohorts. These data
              reveal intricate crosstalk between the germ line and the epigenome
              of primary tumors, which may help identify germline biomarkers of
              aggressive disease to aid patient triage and optimize the use of
              more invasive or expensive diagnostic assays.",
  month    =  oct,
  year     =  2019,
  language = "en"
}


@ARTICLE{Curtis2012-ca,
  title    = "The genomic and transcriptomic architecture of 2,000 breast
              tumours reveals novel subgroups",
  author   = "Curtis, Christina and Shah, Sohrab P and Chin, Suet-Feung and
              Turashvili, Gulisa and Rueda, Oscar M and Dunning, Mark J and
              Speed, Doug and Lynch, Andy G and Samarajiwa, Shamith and Yuan,
